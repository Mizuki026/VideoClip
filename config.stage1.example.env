# Copy to E:\VideoClip\data\mvp-stage-1\.env. Keep generated values private.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:58001
APP_SECRET_KEY=replace-with-at-least-32-random-bytes
APP_DATA_ROOT=E:/VideoClip/data/mvp-stage-1/app
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=24

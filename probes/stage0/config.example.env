# Copy to E:\VideoClip\data\mvp-stage-0\.env and keep it private.
# Use forward slashes for Docker Compose paths.
STAGE0_DATA_DIR=E:/VideoClip/data/mvp-stage-0
STAGE0_PG_PORT=55432
STAGE0_REDIS_PORT=56379
STAGE0_REDIS_RESTORE_PORT=56380

# Set only after verifying account entitlements and free status in the SiliconFlow console.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=
SILICONFLOW_LLM_MODEL=
SILICONFLOW_ASR_PRICE_EVIDENCE=
SILICONFLOW_ASR_USD_PER_MINUTE=
SILICONFLOW_LLM_PRICE_EVIDENCE=
SILICONFLOW_LLM_INPUT_USD_PER_MILLION=
SILICONFLOW_LLM_OUTPUT_USD_PER_MILLION=
SILICONFLOW_FREE_USE_CONFIRMED=

# This is the model's advertised context length from its current model-catalog entry.
LLM_CONTEXT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=3072
LLM_TEMPERATURE=0.2
LLM_ENABLE_THINKING=false
PROMPT_VERSION=stage0-summary-v4

# Finite client and media-process limits; output size limits are hard caps.
HTTP_TOTAL_TIMEOUT_SECONDS=240
HTTP_CONNECT_TIMEOUT_SECONDS=15
HTTP_READ_TIMEOUT_SECONDS=45
MEDIA_TOTAL_TIMEOUT_SECONDS=180
MEDIA_STOP_GRACE_SECONDS=5
MAX_RESPONSE_BYTES=1048576
MAX_DIAGNOSTIC_BYTES=8192
MAX_VIDEO_SECONDS=1200
SEGMENT_SECONDS=30
AUDIO_SAMPLE_RATE=16000
MAX_SUMMARY_REQUESTS=3
